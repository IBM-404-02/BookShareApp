<Page x:Class="BookShareApp.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Админ-панель"
      Background="{StaticResource BgBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Админ-панель"
                   FontSize="26" FontWeight="Bold"
                   Foreground="{StaticResource PrimaryBrush}"
                   Margin="0,0,0,16"/>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Жалобы">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <ItemsControl x:Name="ComplaintsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}"
                                        CornerRadius="6" Padding="14" Margin="0,0,0,8"
                                        BorderThickness="1" BorderBrush="#E0D5EB">
                                    <StackPanel>
                                        <TextBlock>
                                            <Run Text="{Binding TargetTypeRus, Mode=OneWay}" FontWeight="Bold"/>
                                            <Run Text=": "/>
                                            <Run Text="{Binding TargetTitle, Mode=OneWay}" FontWeight="Bold"
                                                 Foreground="{StaticResource PrimaryBrush}"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,4,0,0">
                                            <Run Text="От: " Foreground="{StaticResource MutedBrush}"/>
                                            <Run Text="{Binding ReporterName, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Принять (заморозить)"
                                                    Click="AcceptComplaint_Click" Tag="{Binding Id}"
                                                    Style="{StaticResource SuccessButton}"
                                                    Padding="12,5" Margin="0,0,8,0"/>
                                            <Button Content="Отклонить"
                                                    Click="RejectComplaint_Click" Tag="{Binding Id}"
                                                    Style="{StaticResource DangerButton}"
                                                    Padding="12,5"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            
            <TabItem Header="Апелляции">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <ItemsControl x:Name="AppealsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}"
                                        CornerRadius="6" Padding="14" Margin="0,0,0,8"
                                        BorderThickness="1" BorderBrush="#E0D5EB">
                                    <StackPanel>
                                        <TextBlock>
                                            <Run Text="{Binding TargetTypeRus, Mode=OneWay}" FontWeight="Bold"/>
                                            <Run Text=": "/>
                                            <Run Text="{Binding TargetTitle, Mode=OneWay}" FontWeight="Bold"
                                                 Foreground="{StaticResource PrimaryBrush}"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,4,0,0">
                                            <Run Text="От пользователя: " Foreground="{StaticResource MutedBrush}"/>
                                            <Run Text="{Binding UserName, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Принять (разморозить)"
                                                    Click="AcceptAppeal_Click" Tag="{Binding Id}"
                                                    Style="{StaticResource SuccessButton}"
                                                    Padding="12,5" Margin="0,0,8,0"/>
                                            <Button Content="Отклонить"
                                                    Click="RejectAppeal_Click" Tag="{Binding Id}"
                                                    Style="{StaticResource DangerButton}"
                                                    Padding="12,5"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Заявки авторов">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <ItemsControl x:Name="AuthorRequestsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}"
                                        CornerRadius="6" Padding="14" Margin="0,0,0,8"
                                        BorderThickness="1" BorderBrush="#E0D5EB">
                                    <StackPanel>
                                        <TextBlock Text="{Binding UserName}"
                                                   FontWeight="Bold" FontSize="16"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                        <TextBlock>
                                            <Run Text="Email: " Foreground="{StaticResource MutedBrush}"/>
                                            <Run Text="{Binding UserEmail, Mode=OneWay}"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="Принять (выдать роль)"
                                                    Click="AcceptAuthorRequest_Click" Tag="{Binding Id}"
                                                    Style="{StaticResource SuccessButton}"
                                                    Padding="12,5" Margin="0,0,8,0"/>
                                            <Button Content="Отклонить"
                                                    Click="RejectAuthorRequest_Click" Tag="{Binding Id}"
                                                    Style="{StaticResource DangerButton}"
                                                    Padding="12,5"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Заморожено">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Замороженные пользователи" FontWeight="Bold" FontSize="16"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="FrozenUsersList" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}"
                                            CornerRadius="6" Padding="12" Margin="0,0,0,6"
                                            BorderThickness="1" BorderBrush="#E0D5EB">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FullName}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding FreezeReason}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Разморозить"
                                                    Click="UnfreezeUser_Click" Tag="{Binding Id}"
                                                    Style="{StaticResource SuccessButton}"
                                                    VerticalAlignment="Center" Padding="10,4"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Замороженные книги" FontWeight="Bold" FontSize="16"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="FrozenBooksList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}"
                                            CornerRadius="6" Padding="12" Margin="0,0,0,6"
                                            BorderThickness="1" BorderBrush="#E0D5EB">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding AuthorName}"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock Text="{Binding FreezeReason}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Разморозить"
                                                    Click="UnfreezeBook_Click" Tag="{Binding Id}"
                                                    Style="{StaticResource SuccessButton}"
                                                    VerticalAlignment="Center" Padding="10,4"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Пользователи">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <ItemsControl x:Name="UsersList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}"
                                        CornerRadius="6" Padding="12" Margin="0,0,0,6"
                                        BorderThickness="1" BorderBrush="#E0D5EB">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FullName}" FontWeight="Bold"/>
                                            <TextBlock>
                                                <Run Text="{Binding Login, Mode=OneWay}"
                                                     Foreground="{StaticResource MutedBrush}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding RoleName, Mode=OneWay}"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     FontWeight="Bold"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="Сменить роль"
                                                    Click="ChangeRole_Click" Tag="{Binding Id}"
                                                    Padding="10,4" Margin="0,0,6,0"/>
                                            <Button Content="Сбросить пароль"
                                                    Click="ResetPassword_Click" Tag="{Binding Id}"
                                                    Padding="10,4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
