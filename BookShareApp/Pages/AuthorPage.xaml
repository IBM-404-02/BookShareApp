<Page x:Class="BookShareApp.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторский кабинет"
      Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Авторский кабинет"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       Margin="0,0,0,16"/>

            <Button Grid.Row="1" Content="+ Добавить новую книгу"
                    Click="AddBook_Click"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Left" Padding="18,8"
                    Margin="0,0,0,16"/>

            <TextBlock Grid.Row="2" Text="Мои книги"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       Margin="0,0,0,8"/>

            <ItemsControl x:Name="ActiveBooksList" Grid.Row="3" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}"
                                CornerRadius="6" Padding="14" Margin="0,0,0,8"
                                BorderThickness="1" BorderBrush="#E0D5EB">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="Bold" FontSize="16"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding GenresText}"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding RatingText}"
                                               Foreground="#D4A100" FontWeight="Bold"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Редактировать"
                                        Click="EditBook_Click" Tag="{Binding Id}"
                                        Style="{StaticResource PrimaryButton}"
                                        VerticalAlignment="Center" Padding="12,6"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="4" Text="Замороженные книги"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource DangerBrush}"
                       Margin="0,0,0,8"
                       x:Name="FrozenHeader" Visibility="Collapsed"/>

            <ItemsControl x:Name="FrozenBooksList" Grid.Row="5">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FDECEA"
                                CornerRadius="6" Padding="14" Margin="0,0,0,8"
                                BorderThickness="1" BorderBrush="{StaticResource DangerBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="Bold" FontSize="16"
                                           Foreground="{StaticResource DangerBrush}"/>
                                <TextBlock Text="{Binding FreezeReason}"
                                           TextWrapping="Wrap" Margin="0,4,0,4"/>
                                <Button Content="Подать апелляцию"
                                        Click="AppealBook_Click" Tag="{Binding Id}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left" Padding="12,6"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</Page>
