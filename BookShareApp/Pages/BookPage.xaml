<Page x:Class="BookShareApp.Pages.BookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Книга"
      Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <Button Content="Назад в каталог"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource PrimaryBrush}"
                        Cursor="Hand"
                        Padding="0,0,0,8"
                        Click="Back_Click"/>
                <TextBlock x:Name="TitleText"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="AuthorText"
                           FontSize="14"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,4,0,0"/>
                <TextBlock x:Name="GenresText"
                           FontSize="13"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,2,0,0"/>
                <TextBlock x:Name="RatingText"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#D4A100"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Border x:Name="FrozenPanel"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="#FBE3E3"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Эта книга заморожена"
                               FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock x:Name="FrozenReasonText" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Описание" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Содержание" FontWeight="Bold"/>
                        <Button DockPanel.Dock="Right"
                                Content="Свернуть / Развернуть"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource PrimaryBrush}"
                                Cursor="Hand"
                                HorizontalAlignment="Right"
                                Click="ToggleContent_Click"/>
                    </DockPanel>
                    <ScrollViewer x:Name="ContentScroll"
                                  MaxHeight="300"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,8,0,0">
                        <TextBlock x:Name="ContentText"
                                   TextWrapping="Wrap"
                                   FontSize="14"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Пожаловаться на книгу"
                        Background="{StaticResource DangerBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="12,8"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        Click="ComplainBook_Click"/>
                <Button Content="Пожаловаться на автора"
                        Background="{StaticResource DangerBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="12,8"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        Click="ComplainAuthor_Click"/>
                <Button x:Name="FreezeBookBtn"
                        Content="Заморозить книгу"
                        Background="#444"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="12,8"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        Click="FreezeBook_Click"/>
            </StackPanel>

            <Border Grid.Row="5"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Оставить отзыв" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Оценка:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="RatingBox" Width="80">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5" IsSelected="True"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBox x:Name="ReviewBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="80"
                             VerticalScrollBarVisibility="Auto"/>
                    <Button Content="Опубликовать отзыв"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Click="AddReview_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="6"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="6"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Отзывы" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="ReviewsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8F4FB"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,4">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="{Binding UserName}"
                                                       FontWeight="Bold"/>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding Stars}"
                                                       Foreground="#D4A100"
                                                       HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="Пожаловаться"
                                                    Tag="{Binding Id}"
                                                    Click="ComplainReview_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Cursor="Hand"
                                                    Padding="0"
                                                    FontSize="12"/>
                                            <Button Content="Заморозить"
                                                    Tag="{Binding Id}"
                                                    Click="FreezeReview_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#444"
                                                    Cursor="Hand"
                                                    Padding="0"
                                                    FontSize="12"
                                                    Visibility="{Binding DataContext.AdminVisibility,
                                                        RelativeSource={RelativeSource AncestorType=Page}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
