<Window x:Class="BookShareApp.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход - Читай, Пиши и не спиши"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Border Background="{StaticResource CardBrush}"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="#E0D5EB"
                Padding="40"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Читай, Пиши и не спиши"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource PrimaryBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Платформа обмена книгами"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Логин" Margin="0,0,0,4" Foreground="{StaticResource TextBrush}"/>
                <TextBox x:Name="LoginBox" Margin="0,0,0,12" Padding="6"/>

                <TextBlock Text="Пароль" Margin="0,0,0,4" Foreground="{StaticResource TextBrush}"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,20" Padding="6"/>

                <Button Content="Войти"
                        Style="{StaticResource PrimaryButton}"
                        Click="LoginButton_Click"
                        Height="40"
                        FontSize="15"
                        Margin="0,0,0,12"/>

                <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}">
                    <Run Text="Нет аккаунта?"/>
                    <Hyperlink Foreground="{StaticResource PrimaryBrush}" Click="RegisterLink_Click">
                        Зарегистрироваться
                    </Hyperlink>
                </TextBlock>

                <TextBlock Text="Тестовые учётки: admin/admin, author/author, user/user"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
