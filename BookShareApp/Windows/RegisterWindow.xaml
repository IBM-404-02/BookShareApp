<Window x:Class="BookShareApp.Windows.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Border Background="{StaticResource CardBrush}"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="#E0D5EB"
                Padding="40"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Регистрация"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource PrimaryBrush}"
                           Margin="0,0,0,24"/>

                <TextBlock Text="ФИО" Margin="0,0,0,4"/>
                <TextBox x:Name="FullNameBox" Margin="0,0,0,10" Padding="6"/>

                <TextBlock Text="Логин" Margin="0,0,0,4"/>
                <TextBox x:Name="LoginBox" Margin="0,0,0,10" Padding="6"/>

                <TextBlock Text="Email" Margin="0,0,0,4"/>
                <TextBox x:Name="EmailBox" Margin="0,0,0,10" Padding="6"/>

                <TextBlock Text="Пароль" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10" Padding="6"/>

                <TextBlock Text="Повторите пароль" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox2" Margin="0,0,0,20" Padding="6"/>

                <Button Content="Зарегистрироваться"
                        Style="{StaticResource PrimaryButton}"
                        Click="RegisterButton_Click"
                        Height="40"
                        FontSize="15"
                        Margin="0,0,0,8"/>

                <Button Content="Отмена"
                        Click="CancelButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource MutedBrush}"
                        Cursor="Hand"
                        Height="32"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
