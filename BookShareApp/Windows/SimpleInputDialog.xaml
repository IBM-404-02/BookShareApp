<Window x:Class="BookShareApp.Windows.SimpleInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="220" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <Border Padding="20">
        <StackPanel>
            <TextBlock x:Name="MessageText" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBox x:Name="InputBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Отмена"
                        Click="Cancel_Click"
                        Margin="0,0,8,0"
                        Padding="14,6"
                        Background="Transparent"
                        BorderBrush="{StaticResource MutedBrush}"
                        BorderThickness="1"
                        Cursor="Hand"/>
                <Button Content="OK"
                        Click="Ok_Click"
                        Style="{StaticResource PrimaryButton}"
                        Padding="20,6"
                        IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
